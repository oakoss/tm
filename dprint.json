{
  "excludes": [
    "Cargo.lock",
    ".beads/**",
    "**/*.md"
  ],
  "indentWidth": 2,
  "json": {},
  "lineWidth": 80,
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ],
  "useTabs": false,
  "yaml": {
    "quotes": "preferSingle"
  }
}
